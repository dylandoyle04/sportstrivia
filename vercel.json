{
  "rewrites": [
    { "source": "/api/balldontlie/:path*", "destination": "/api/proxy" },
    { "source": "/api/hockey/:path*", "destination": "/api/proxy" },
    { "source": "/api/mlb/:path*", "destination": "https://statsapi.mlb.com/:path*" }
  ],
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 12 * * *" }
  ]
}
